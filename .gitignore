.env
.env.*
!.env.example
node_modules/
dist/
build/
*.js.map
*.log
.DS_Store
.codex
.omx/

# Runtime audio storage — generated at runtime, never commit
storage/audio/converted/*
storage/audio/originals/*
storage/audio/previews/*
storage/audio/tts/*
storage/audio/voices/*
storage/voicemail/*
asterisk/logs/
*.tsbuildinfo
.gstack/
coverage/

# Relay runtime files — contain private keys and VPS details
wireguard-config/relay-runtime/
wireguard-config/relay-state.json
wireguard-config/callytics-relay.conf
wireguard-config/relay-callytics-private.key
wireguard-config/relay-callytics-public.key
asterisk/base/pjsip_relay.conf
asterisk/base/pjsip_webrtc.conf
asterisk/base/pjsip_extensions_relay.conf
asterisk/base/pjsip_callytics_trunks.conf
asterisk/base/pjsip_callytics_extensions.conf
asterisk/base/extensions_callytics_inbound.conf

# Asterisk config generated by the backend or the asterisk container entrypoint
asterisk/base/pjsip_callytics_*.conf
asterisk/base/pjsip_extensions_relay.conf
asterisk/base/pjsip_relay.conf
asterisk/base/pjsip_webrtc.conf
asterisk/base/pjsip_callytics_vpn_*.conf
asterisk/base/extensions_callytics_inbound.conf
asterisk/base/rtp.conf
asterisk/base/ari.conf
asterisk/base/manager.conf
asterisk/base/pjsip_transports.conf
asterisk/base/http.conf
asterisk/base/pjsip_tls.conf
