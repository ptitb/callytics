# Timezone
# Timezone for display, CDR export, and log formatting. Storage is always UTC. Example: Asia/Colombo, America/New_York.
TZ=UTC
VITE_DISPLAY_TIMEZONE=UTC

# Database connection (required: backend + stasis)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=callytics
DB_USER=callytics
# Secret: generated by scripts/install.sh. Required by docker compose.
DB_PASS=
# Optional (tests only): admin DB name used by backend test setup fallback
DB_ADMIN_NAME=postgres
# Optional (tests/compose compatibility): fallback DB name alias used by test setup
POSTGRES_DB=callytics
# Optional (tests/compose compatibility): fallback DB password alias used by test setup
POSTGRES_PASSWORD=

# Redis connection (required: backend + stasis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Asterisk ARI (required)
ARI_URL=http://127.0.0.1:8088
ARI_USER=callytics
# Secret: generated by scripts/install.sh. Required by docker compose.
ARI_PASS=
ARI_APP=callytics
# Optional alias: some backend checks read ARI_PASSWORD explicitly
ARI_PASSWORD=

# Asterisk AMI (required)
AMI_HOST=127.0.0.1
# Change when another Asterisk (for example FreePBX) already uses 5038 on this host.
AMI_PORT=5038
AMI_USER=callytics
# Secret: generated by scripts/install.sh. Required by docker compose.
AMI_PASS=
# Optional alias: backend services also accept AMI_PASSWORD
AMI_PASSWORD=

# Bind addresses. The web UI and API have no authentication, so they listen on loopback by default.
# Put a TLS reverse proxy (for example Caddy) in front, see INSTALL.md and deploy/examples/.
# Web UI (nginx, port 3000)
WEB_BIND_ADDR=127.0.0.1
# Backend API (port BACKEND_PORT)
BACKEND_BIND_ADDR=127.0.0.1
# Asterisk HTTP: ARI and the WebRTC WebSocket on port 8088 (the web proxy forwards /ws to it)
ARI_BIND_ADDR=127.0.0.1

# Backend runtime (required)
BACKEND_PORT=3001
NODE_ENV=development
# Optional: absolute backend base URL used by stasis HTTP callbacks/fetches
BACKEND_URL=http://127.0.0.1:3001
# Optional: stasis health server port (compose defaults to 3002)
STASIS_HEALTH_PORT=3002

# Internal auth token between stasis and backend recording APIs (required for runtime integration)
# Secret: generated by scripts/install.sh. Required by docker compose.
RECORDINGS_INTERNAL_TOKEN=

# Host/public addressing and SIP relay tuning
# Required in non-local deployments: used for SIP registration QR/provisioning URLs and VPN fallback IP.
HOST_IP=127.0.0.1
# Optional: LAN CIDR override injected into generated pjsip relay transport local_net.
LOCAL_NET=192.168.1.0/24
# Required for SIP listener: Asterisk bind port (avoid conflict with host 5060 if needed).
SIP_PORT=5080
# SIP over TLS (optional, disabled while SIP_TLS_CERT_DIR is empty).
# Softphones register over TLS with SRTP on this port.
SIP_TLS_PORT=5081
# Host directory with the certificate and key, mounted read-only into the asterisk container.
# Caddy (apt install) keeps its Let's Encrypt certificates in
# /var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/<SIP_TLS_HOSTNAME>
# (as root: /root/.local/share/caddy/...). When Docker does not run as root the
# container cannot read that directory: copy the files with
# deploy/examples/callytics-tls-sync.sh and use its TARGET_DIR (/etc/callytics/tls) here.
SIP_TLS_CERT_DIR=
# DNS name softphones connect to and the certificate is issued for, for example sip.example.com
SIP_TLS_HOSTNAME=
# Optional: file names inside SIP_TLS_CERT_DIR. Default: <SIP_TLS_HOSTNAME>.crt and <SIP_TLS_HOSTNAME>.key (Caddy layout).
SIP_TLS_CERT_FILE=
SIP_TLS_KEY_FILE=
# Optional: seconds between checks for a renewed certificate (a renewal reloads res_pjsip, no restart needed).
SIP_TLS_WATCH_INTERVAL=3600
# Optional: fixed public IP override for VPN relay templating and external address resolution.
VPN_PUBLIC_IP=
# Optional: 64-char hex key for VPN relay private-key encryption at rest. If unset/invalid, key is derived from HOST_IP.
ENCRYPTION_KEY=

# Optional filesystem overrides (useful in tests/custom deploy layouts)
# Optional: Asterisk config directory path used by backend config writers.
ASTERISK_CONFIG_DIR=/etc/asterisk
# Optional: WireGuard config directory used by backend VPN service.
WIREGUARD_CONFIG_DIR=../wireguard-config
# Optional: backup output directory used by backend backup service.
BACKUP_DIR=/app/backups
# Optional: recordings root used by backend backup/restore service.
RECORDINGS_DIR=/var/lib/asterisk/recording
# Optional: audio storage root used by backend backup/restore service.
AUDIO_STORAGE_DIR=/app/storage/audio
# Optional: GeoIP DB directory used by firewall diagnostics/jobs.
GEOIP_DIR=/app/geoip

# Optional callback/queue MOH behavior (stasis)
# Optional: MOH class for direct outbound callbacks.
CALLBACK_MOH_CLASS=callytics-hold
# Optional: MOH class for queue login / queue waiting / conference hold flows.
QUEUE_LOGIN_MOH_CLASS=callytics-hold
# Optional: MOH class for direct outbound dialing flows.
DIRECT_OUTBOUND_MOH_CLASS=callytics-hold
# Optional: how long a direct outbound call (# prefix) waits for the provider to answer, in ms (minimum 1000).
DIRECT_OUTBOUND_TIMEOUT_MS=30000
# Optional: default ISO country code for callback destination normalization.
CALLBACK_DEFAULT_COUNTRY=US

# RTP port range used for the first start. Afterwards it is managed in Settings > Media (RTP).
# Pick a range that does not overlap other PBX software on this host (FreePBX uses 10000-20000).
RTP_PORT_START=10000
RTP_PORT_END=20000

# Maximum upload size in MB. Used by the web proxy (nginx) and the audio upload endpoint.
UPLOAD_MAX_MB=100

# Optional capture sidecar flags (asterisk docker capture-sidecar.js)
TSHARK_ENABLED=true
# Optional: compose sets this to SIP_PORT.
TSHARK_PORT=5080

# Optional firewall GeoIP download key (required only when enabling MaxMind auto-download/update)
MAXMIND_LICENSE_KEY=

# Frontend build/runtime env (optional)
# Default behavior: frontend uses same-origin routes (`/api`, `/socket.io`, `/media`) via proxy.
# Set only when running without proxy or with a custom upstream origin.
# VITE_API_BASE_URL=http://127.0.0.1:3001
# Optional explicit Socket.IO base URL (defaults to same-origin when unset).
# VITE_SOCKET_BASE_URL=http://127.0.0.1:3001
# Optional Socket.IO path (defaults to /socket.io).
# VITE_SOCKET_PATH=/socket.io
# Optional explicit media origin for preview/download URLs.
# VITE_MEDIA_BASE_URL=http://127.0.0.1:3001
# Optional: frontend version label shown in UI (Vite injects from package version by default).
VITE_APP_VERSION=dev
# Optional: Vite test-mode flag used by config when running Vitest.
VITEST=
# Optional: Vite dev-server proxy target override for /api, /socket.io, /media.
# VITE_DEV_BACKEND_TARGET=http://127.0.0.1:3001

# Optional backend test harness override (tests only)
TEST_DATABASE_URL=

# Optional WireGuard container identity (docker-compose wireguard profile)
PUID=1000
PGID=1000
# Optional: public hostname/IP wireguard container advertises (compose default: auto).
WIREGUARD_SERVERURL=auto

# E-mail notifications (notifier service)
# The notifier receives flow webhooks and mails a missed call or a new voicemail (MP3 attached) to one address.
# It always starts with the stack. Without SMTP_HOST, NOTIFY_FROM and NOTIFY_TO it answers 503 to webhooks.
# Secret: generated by scripts/install.sh. Callytics webhook nodes send it in the X-Callytics-Token header.
NOTIFIER_TOKEN=
# Bind address and port of the notifier. Keep 127.0.0.1 unless Callytics runs on another host.
NOTIFIER_BIND_ADDR=127.0.0.1
NOTIFIER_PORT=3005
# SMTP server. Port 587 with SMTP_SECURE=false uses STARTTLS when the server offers it. Port 465 needs SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Leave SMTP_USER and SMTP_PASS empty for a server without authentication. Set both or neither.
SMTP_USER=
SMTP_PASS=
# Sender address and recipients (comma separated), for example callytics@example.com and info@example.com.
NOTIFY_FROM=
NOTIFY_TO=
# Language of the mails: nl or en.
NOTIFY_LANGUAGE=nl
# Time zone for the times in the mails (IANA name).
NOTIFY_TIMEZONE=Europe/Amsterdam
# BACKEND_URL (above) is also the only origin the notifier downloads voicemail recordings from.
